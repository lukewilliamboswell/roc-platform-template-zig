#!/usr/bin/env roc-stable
app [main!] {
	cli: platform "https://github.com/roc-lang/basic-cli/releases/download/0.25.0/CZsY7tYZwR3rj9kYbpaCfxki2yVAaRL8bBwMLvB2xkbA.tar.zst",
	roc: "nightly-2026-10-09-258ab27",
}

import cli.Cmd
import cli.OsStr
import cli.Path
import cli.Stderr
import cli.Stdout
import src/Bundle
import src/Policy

## Everything `blueprint run check` checks, in order. Run from the repository
## root, inside the Blueprint environment.
##
##   1. no compiler pin outside `scripts/` (`scripts/check_no_pins.roc`);
##   2. no compiled artifact tracked in Git;
##   3. the scripts: the tests of their modules without effects under `scripts/src/`,
##      `roc-stable check` of each script, and `roc-stable fmt --check`;
##   4. the Zig sources: `zig fmt --check`, except generated and vendored
##      files, and the linker-input tool's tests.
##
## `roc-stable` runs the scripts. Bare `roc`, the latest nightly, is what the
## platform and its examples are tested with, by `blueprint run test`.
main! : List(OsStr) => Try({}, [Exit(I32)])
main! = |args| {
	if !args.is_empty() {
		_ = Stderr.line!("usage: scripts/check_all.roc")
		return Err(Exit(2))
	}
	match run!({}) {
		Ok({}) => Ok({})
		Err(message) => {
			_ = Stderr.line!("error: ${message}")
			Err(Exit(1))
		}
	}
}

run! : {} => Try({}, Str)
run! = |{}| {
	section!("Compilers")?
	succeed!("roc-stable", ["version"])?

	section!("Compiler pins")?
	succeed!("scripts/check_no_pins.roc", [])?

	section!("Compiled artifacts")?
	binaries!({})?

	section!("Scripts")?
	# The modules without effects carry the tests of the scripts' logic; the
	# modules with effects are checked through the scripts that import them.
	for source in roc_files!("scripts/src")? {
		text = Path.read_utf8!(Path.utf8(source)).map_err(|_| "cannot read ${source}")?
		if !text.contains("import cli.") {
			succeed!("roc-stable", ["test", source])?
		}
	}
	for script in roc_files!("scripts")? {
		succeed!("roc-stable", ["check", script])?
	}
	succeed!("roc-stable", ["fmt", "--check", "scripts"])?

	section!("Zig")?
	# src/roc_platform_abi.zig is generated by `roc glue` and kept as generated;
	# the MSVC runtime sources are vendored unchanged from Roc.
	zig_sources = (files_ending!("src", ".zig")?).drop_if(|path| path == "src/roc_platform_abi.zig")
	succeed!("zig", ["fmt", "--check", "build.zig", "tools"].concat(zig_sources))?
	succeed!("zig", ["test", "tools/link_inputs.zig"])
}

## Compiled artifacts are built or fetched, never committed; executable
## scripts are allowed.
binaries! : {} => Try({}, Str)
binaries! = |{}| {
	listing = capture!("git", ["ls-files", "-z"])?
	var $found = []
	for path in listing.split_on("\u(0)").keep_if(|path| path != "") {
		match Path.type!(Path.utf8(path)) {
			Ok(IsFile) => {
				bytes = Path.read_bytes!(Path.utf8(path)).map_err(|_| "cannot read ${path}")?
				if Policy.compiled(path, bytes.take_first(8)) {
					$found = $found.append(path)
				}
			}
			_ => {}
		}
	}
	if !$found.is_empty() {
		return Err("compiled artifacts must be built or fetched, not committed:\n  ${Str.join_with($found, "\n  ")}")
	}
	Stdout.line!("PASS no compiled artifacts tracked in Git").map_err(|_| "cannot write to stdout")
}

## The `.roc` files directly inside `directory`, in a stable order.
roc_files! : Str => Try(List(Str), Str)
roc_files! = |directory| files_ending!(directory, ".roc")

## The files directly inside `directory` whose names end with `suffix`, in a stable order.
files_ending! : Str, Str => Try(List(Str), Str)
files_ending! = |directory, suffix| {
	entries = Path.list!(Path.utf8(directory)).map_err(|_| "could not list ${directory}")?
	Ok(entries.map(Path.display).keep_if(|path| path.ends_with(suffix)).sort_with(Bundle.compare))
}

section! : Str => Try({}, Str)
section! = |name| Stdout.line!("\n== ${name}").map_err(|_| "cannot write to stdout")

capture! : Str, List(Str) => Try(Str, Str)
capture! = |program, args| {
	output = Cmd.new_str(program).args_str(args).run!().map_err(|_| "could not run ${program}")?
	match output.status {
		Exited(0) => Ok(Str.from_utf8_lossy(output.stdout_bytes))
		_ => Err("${program} ${Str.join_with(args, " ")} failed: ${Str.from_utf8_lossy(output.stderr_bytes)}")
	}
}

## Print a command, then run it with inherited output; a non-zero exit is an error.
succeed! : Str, List(Str) => Try({}, Str)
succeed! = |program, args| {
	Stdout.line!("+ ${program} ${Str.join_with(args, " ")}").map_err(|_| "cannot write to stdout")?
	match Cmd.new_str(program).args_str(args).exec_exit_code!() {
		Ok(0) => Ok({})
		Ok(code) => Err("${program} ${Str.join_with(args, " ")} exited with code ${code.to_str()}")
		Err(_) => Err("could not run ${program}")
	}
}
